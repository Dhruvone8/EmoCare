# EmoCare Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Dashboard Configuration
DASHBOARD_PORT=8501
API_BASE_URL=http://localhost:8000

# Database Configuration (Supabase PostgreSQL)
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Auth Configuration (for Frontend Next.js / Dashboard)
# Get from Supabase Dashboard -> Project Settings -> API / Data API
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-PUBLIC-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-LEGACY-JWT-SECRET]
# Optional for projects using Supabase asymmetric signing keys instead of the legacy secret.
SUPABASE_JWKS_URL=https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
# Generate an independent random value with at least 32 bytes; never expose it to the frontend.
GUEST_SESSION_SECRET=[YOUR-RANDOM-GUEST-SESSION-SECRET]


# Model Paths
TEXT_MODEL_PATH=models/text/
SPEECH_MODEL_PATH=models/speech/
RISK_MODEL_PATH=models/risk/

# ── Therapy Engine (Phase 2-3) ─────────────────────────────────
# Provider Choice: openrouter | groq | anthropic | openai (Leave blank for auto-detection)
LLM_PROVIDER=openrouter

# 1. OpenRouter (Free models available: meta-llama/llama-3.3-70b-instruct:free, etc.)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=[YOUR-OPENROUTER-API-KEY]
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 2. Groq (100% Free fast LLM API)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=[YOUR-GROQ-API-KEY]
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Anthropic Claude (Optional)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=[YOUR-ANTHROPIC-API-KEY]

# 4. OpenAI (Used for Whisper STT audio transcription or fallback LLM)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=[YOUR-OPENAI-API-KEY]

# ── Voice Synthesis (TTS) ──────────────────────────────────────
# ElevenLabs API key — used for TTS (voice therapy spoken responses, 10,000 chars/mo free)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=[YOUR-ELEVENLABS-API-KEY]

# ElevenLabs Voice ID — calm, warm voice for therapy responses
# Find voices at: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
